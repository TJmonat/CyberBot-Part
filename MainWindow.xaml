<Window x:Class="POE2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POE2"
        mc:Ignorable="d"
        Title="ChatBot" 
        Height="600"
        Width="900"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
                Background="Lavender"
                BorderBrush="SeaGreen"
                BorderThickness="0,0,0,3">
            
            
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="======================================"
                           FontSize="18"
                           Foreground="SeaGreen"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"/>
                <!-- ASCII ART-->
                <TextBlock Text="||  Cyber Awareness Bot ||"
                           FontSize="26"
                           Foreground="SeaGreen"
                           FontWeight="Light"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="======================================"
                           FontSize="18"
                           Foreground="SeaGreen"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="10">
                <!--ADDING MY IMAGE-->
                <Image Width="200"
                       Height="130"
                       Stretch="Fill"
                       Source="C:\Users\tsheg\source\repos\POE2\POE2\profile.jpeg"/>

            </Border>
        </Grid>
        </Border>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="White">
            <StackPanel x:Name="ChatPanel"
                        Margin="10"/>

        </ScrollViewer>
        <Grid Grid.Row="2"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageTextBox"
                     FontSize="16"
                     Height="40"
                     Background="Lavender"
                     BorderThickness="2"
                     VerticalContentAlignment="Center"
                     Margin="10,0,0,10" TextChanged="MessageTextBox_TextChanged"/>
            <Button Grid.Column="1"
                    Content="Send"
                    Height="40"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="SeaGreen"
                    Foreground="Black"
                    Click="SendButton_Click"/>
        </Grid>


    </Grid>
</Window>
